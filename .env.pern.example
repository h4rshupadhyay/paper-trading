# Copy to .env.pern.local (git-ignored) and fill the three empty required values.
# Empty values deliberately fail closed; this file contains no working credentials.
# Scripts do not automatically load this file. See docs/PERN_SETUP.md.
NODE_ENV=development
PORT=3001
PUBLIC_ORIGIN=http://localhost:3000

# Runtime login: paper_app; never the schema owner or a database administrator.
# Format: postgresql://paper_app:<URL_ENCODED_PASSWORD>@<NEW_PG_HOST>:5432/paper_foundation
DATABASE_URL=''
# Deployment-only login: paper_owner, for the explicit db:migrate command.
# Format: postgresql://paper_owner:<URL_ENCODED_PASSWORD>@<NEW_PG_HOST>:5432/paper_foundation
MIGRATION_DATABASE_URL=''
# Generate at least 32 random bytes; keep stable across API restarts.
CSRF_SECRET=''

# Explicit provider mode. Fixture is simulated data and forbidden in production.
MARKET_PROVIDER=yahoo
