{
  "name": "@paper/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "test:unit": "vitest run --project unit --passWithNoTests",
    "test:integration": "vitest run --project integration",
    "db:migrate": "tsx src/platform/migrate.ts",
    "start:api": "node dist/src/api.js",
    "start:worker": "node dist/src/worker.js",
    "market:validate": "tsx test/provider-validation.ts"
  },
  "dependencies": {
    "@paper/contracts": "0.0.0",
    "bcrypt": "6.0.0",
    "cookie-parser": "1.4.7",
    "express": "5.3.0",
    "helmet": "8.3.0",
    "pg": "8.23.1",
    "pg-connection-string": "2.14.1",
    "pino": "10.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/bcrypt": "6.0.0",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
