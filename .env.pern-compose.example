# Copy to .env.pern-compose.local and use independently generated hex secrets.
# Empty required secrets deliberately prevent startup. Do not reuse these roles elsewhere.
PAPER_ADMIN_PASSWORD=
PAPER_OWNER_PASSWORD=
PAPER_APP_PASSWORD=
CSRF_SECRET=
PUBLIC_ORIGIN=http://localhost:3000
PERN_WEB_PORT=3000
NODE_ENV=development
# Optional HTTPS edge source trust; see docs/PERN_INGRESS.md before changing.
TRUSTED_INGRESS_CIDR=127.0.0.1/32
# yfinance: Yahoo prices through the Python service for paper trading.
# yahoo: earlier display-only adapter.
# fixture: explicitly simulated development/test data; forbidden in production.
MARKET_PROVIDER=yfinance
