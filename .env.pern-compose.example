# Copy to .env.pern-compose.local and use independently generated hex secrets.
# Empty required secrets deliberately prevent startup. Do not reuse these roles elsewhere.
PAPER_ADMIN_PASSWORD=
PAPER_OWNER_PASSWORD=
PAPER_APP_PASSWORD=
CSRF_SECRET=
PUBLIC_ORIGIN=http://localhost:3000
PERN_WEB_PORT=3000
NODE_ENV=development
# yahoo: real display data, trading gated until provider validation succeeds.
# fixture: explicitly simulated development/test data; forbidden in production.
MARKET_PROVIDER=yahoo
